# Read by docker-compose.yml at the repo root. Copy this file to `.env` and fill in real
# values — never commit the real `.env`.
#
# This is distinct from backend/src/.env and frontend/.env, which are what LOCAL (non-Docker)
# dev uses and are unaffected by this file. See CLAUDE.md's "Environment variables" section for
# that separate contract.

# --- Database --------------------------------------------------------------------------------
# Also become the Postgres container's own credentials (see docker-compose.yml's `db` service).
SQL_USER=
SQL_PASS=
SQL_DB=
# Present for completeness, but the `backend` service ignores both of these and always
# connects to `db:5432` internally over the compose network — they don't need to match
# whatever backend/src/.env uses for local dev.
SQL_HOST=db
SQL_PORT=5432

# --- Backend ----------------------------------------------------------------------------------
# Session-cookie signing secret. Required — the server fails fast at startup if unset.
SECRET_KEY=

# Comma-separated CORS allowlist. Set to the deployment's real origin, e.g.
# https://woodenbizarre.tech — the frontend and API are same-origin behind Caddy in this
# deployment, so this mostly matters as defense-in-depth against something bypassing the proxy.
ALLOWED_ORIGINS=

# Leave `false` until SITE_ADDRESS below is a real domain (TLS is then automatic — see
# frontend/Caddyfile). Setting this `true` before then means the session cookie is never sent by
# the browser and every login fails.
COOKIE_SECURE=false

# --- Proxy (Caddy) -----------------------------------------------------------------------------
# The domain Caddy requests a Let's Encrypt certificate for and serves HTTPS on. Leave unset (or
# ":80") for plain HTTP with no TLS — that's what local `docker compose up` and CI's compose
# smoke test use. On the VPS, set to the real domain, e.g.:
# SITE_ADDRESS=woodenbizarre.tech
SITE_ADDRESS=
# The same domain, used only for the www -> root redirect (frontend/Caddyfile).
DOMAIN=woodenbizarre.tech
# Portainer's own subdomain, e.g. portainer.woodenbizarre.tech. Leave unset to leave the
# Portainer site block inert (local dev, CI).
PORTAINER_ADDRESS=

# --- Deploy (set by CI, not filled in by hand) --------------------------------------------------
# The image tag deploy/deploy.sh pulls — a commit SHA on the VPS, defaults to `latest` for local
# `docker compose up --build`. Never commit a real value here.
IMAGE_TAG=
