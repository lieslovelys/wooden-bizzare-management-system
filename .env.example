# Read by docker-compose.yml at the repo root. Copy this file to `.env` and fill in real
# values — never commit the real `.env`.
#
# This is distinct from backend/src/.env and frontend/.env, which are what LOCAL (non-Docker)
# dev uses and are unaffected by this file. See CLAUDE.md's "Environment variables" section for
# that separate contract.

# --- Database --------------------------------------------------------------------------------
# Also become the Postgres container's own credentials (see docker-compose.yml's `db` service).
SQL_USER=
SQL_PASS=
SQL_DB=
# Present for completeness, but the `backend` service ignores both of these and always
# connects to `db:5432` internally over the compose network — they don't need to match
# whatever backend/src/.env uses for local dev.
SQL_HOST=db
SQL_PORT=5432

# --- Backend ----------------------------------------------------------------------------------
# Session-cookie signing secret. Required — the server fails fast at startup if unset.
SECRET_KEY=

# Comma-separated CORS allowlist. Set to the VPS's real IP (or eventual domain), e.g.
# http://203.0.113.10 — the frontend and API are same-origin behind Nginx in this deployment,
# so this mostly matters as defense-in-depth against something bypassing the proxy.
ALLOWED_ORIGINS=

# Leave `false` until a domain + TLS (Certbot) is added in front of Nginx. Setting this `true`
# before then means the session cookie is never sent by the browser and every login fails.
COOKIE_SECURE=false
